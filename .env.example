# ════════════════════════════════════════════════════════════
#  SC&WMS — environment variables
#  1) Copy this file to  .env   (same folder as app.py)
#  2) Fill in the values below
#  3) NEVER upload .env to GitHub  (it is listed in .gitignore)
#  On Vercel: add the same names under Project → Settings → Environment Variables
# ════════════════════════════════════════════════════════════

# ── Flask ───────────────────────────────────────────────────
# any long random string:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── DATABASE ────────────────────────────────────────────────
# Cloud / Vercel: full connection string (Neon, Supabase, ...)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local PostgreSQL (used only when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# Optional: a READ-ONLY database user just for the AI assistant (see database/ai_readonly_role.sql)
# AI_DATABASE_URL=

# ── AI ASSISTANT  (free keys — add AFTER your final code changes) ─────
# Gemini key:  https://aistudio.google.com  → "Get API key"
GEMINI_API_KEY=
# Groq key:    https://console.groq.com     → "API Keys"
GROQ_API_KEY=

# auto = Gemini first, Groq as automatic backup | gemini | groq
AI_PROVIDER=auto
# model names are tried left → right (change here if a model is retired)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
